generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid()) // ID interno local
  clerkUserId String?  @unique // ID do Clerk (opcional para fallback)
  email       String?  @unique // Email autenticado
  username    String?  @unique // Nome de usuário público
  displayName String? // Nome visível
  pictureUrl  String? // Avatar
  bio         String? // Biografia curta
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Status e preferências
  isActive    Boolean   @default(true)
  lastLoginAt DateTime? // Último login
  role        Role      @default(USER)

  // Relações
  discord DiscordToken?

  @@index([email])
  @@index([username])
  @@index([clerkUserId])
}

model DiscordToken {
  id            String   @id @default(cuid())
  userId        String   @unique
  accessToken   String // armazenado cifrado
  refreshToken  String // armazenado cifrado
  scope         String
  tokenType     String
  expiresAt     DateTime
  discordId     String
  username      String? // nome no Discord
  discriminator String? // ex: #0421
  avatarUrl     String? // avatar no Discord
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
  MODERATOR
}
